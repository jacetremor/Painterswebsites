# Public Supabase values. The publishable key is safe for browser use with RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix with NEXT_PUBLIC or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
CONTACT_EMAIL_PROVIDER_API_KEY=
CONTACT_FROM_EMAIL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_ENDPOINT=
AI_PROVIDER_MODEL=

# Initial onboarding content provider. Draft generation remains human-approved.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Server-side geocoder + reputable place-data adapter (for example, U.S. Census-backed).
GEOGRAPHY_PROVIDER_ENDPOINT=
GEOGRAPHY_PROVIDER_API_KEY=
CRON_SECRET=
NEXT_PUBLIC_PLATFORM_APP_URL=https://app.novasuite.io

# App and deployment controls.
NEXT_PUBLIC_APP_URL=http://summit.localhost:3000
VERCEL_ENV=development
PREVIEW_BYPASS_TOKEN=
