# Public Supabase values. The publishable key is safe for browser use with RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix with NEXT_PUBLIC or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
CONTACT_EMAIL_PROVIDER_API_KEY=
CONTACT_FROM_EMAIL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_ENDPOINT=
AI_PROVIDER_MODEL=

# App and deployment controls.
NEXT_PUBLIC_APP_URL=http://summit.localhost:3000
VERCEL_ENV=development
PREVIEW_BYPASS_TOKEN=
